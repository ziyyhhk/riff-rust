{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Riff Rust",
  "version": "0.1.4",
  "identifier": "io.github.rootscripts.riffrust",
  "build": {
    "beforeBuildCommand": "npm run assemble",
    "beforeDevCommand": "npm run assemble",
    "frontendDist": "../web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "installMode": "currentUser"
      }
    }
  }
}
